-    function crc16Modbus(bytes) {
-      let crc = 0xFFFF;
-      for (const byte of bytes) {
-        crc ^= byte;
-        for (let bit = 0; bit < 8; bit += 1) crc = (crc & 1) ? ((crc >>> 1) ^ 0xA001) : (crc >>> 1);
-      }
-      return crc;
-    }

+        });
+        toast('Hub settings saved! Reconnecting to serial port…', 'ok');
+        closeModal('modal-edit-hub');
+        await refreshData();
+      } catch(e) {
+        toast('Failed to save hub settings: ' + e.message, 'err');
+      }
+    }
diff --git a/custom_components/modbus_usb/www/panel/main.js b/custom_components/modbus_usb/www/panel/main.js
